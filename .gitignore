# ignore
.vscode/
.DS_Store

# tmp
bin/
obj/
tmp/
publish/
*.jsonl
*.json
*.zip

# Build output
module/*.dll
module/*.pdb
module/*.json
module/Dependencies/
module/.build-hash

# Test outputs
tests/TestResults.xml
tests/benchmarks/results/*

# results/ above stays local: it is the append-only per-run log, and one machine's numbers are
# not another's. The baseline beside it is the pinned snapshot a later run is read against, and
# it is committed, so it has to be re-included after *.json has had its say. Nothing here
# re-includes results/ itself.
!tests/benchmarks/baseline.json

# Generated by the CI compat job when run locally
compat-surface-tests.ps1
