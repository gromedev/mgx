<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Mgx.Engine</RootNamespace>
    <!-- CA1416: a large part of the Windows-only .NET surface (SecurityIdentifier, registry,
         WMI) is [SupportedOSPlatform("windows")]. Mgx runs on Linux and macOS, so promoting
         this to an error turns a runtime PlatformNotSupportedException on a non-Windows host
         into a build failure -->
    <WarningsAsErrors>$(WarningsAsErrors);CA1416</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mgx.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Polly.Core" Version="8.7.0" />
    <PackageReference Include="System.Threading.RateLimiting" Version="10.0.10" />

  </ItemGroup>

</Project>
